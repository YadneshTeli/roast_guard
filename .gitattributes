# Auto-detect text files and normalize line endings
* text=auto

# Keep shell scripts with LF and Windows scripts with CRLF
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.so binary
